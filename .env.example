PLAID_ENV=sandbox
PLAID_CLIENT_ID=replace_with_your_client_id
PLAID_SECRET=replace_with_your_sandbox_secret

# Live/Production uses explicit credentials; never replace the Sandbox secret.
# Client ID can be shared; PLAID_PRODUCTION_CLIENT_ID is an optional override.
PLAID_PRODUCTION_SECRET=
PLAID_PRODUCTION_CLIENT_ID=
# Keep false while preparing. Enable only for a separately approved live pilot.
PLAID_LIVE_ENABLED=false
# Optional desktop-web OAuth redirect; if used, HTTPS + Dashboard allowlist required.
PLAID_PRODUCTION_REDIRECT_URI=
